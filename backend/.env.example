DEBUG=True
SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=sqlite:///db.sqlite3

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

CORS_ALLOWED_ORIGINS=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend: https://resend.com/api-keys — dev: use the shared onboarding@resend.dev test domain.
# Once komi-africa.site is verified in Resend, just change DEFAULT_FROM_EMAIL below.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=KOMI <onboarding@resend.dev>

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
STORE_DOMAIN_SUFFIX=komi.shop

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# FedaPay sandbox: https://sandbox-dashboard.fedapay.com
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=

# Comy (Groq): https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
